    <!-- DWG/DXF çizim dosyalarını okumak için: ücretsiz, açık kaynak (MIT lisanslı), alpha aşamasında -->
    <PackageReference Include="ACadSharp" Version="1.4.0-alpha" />
  </ItemGroup>

</Project>
