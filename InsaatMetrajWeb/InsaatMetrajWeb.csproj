<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>InsaatMetrajWeb</RootNamespace>
    <UserSecretsId>10a9c268-79e3-47e1-b000-2e2d4cb1583e</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- PDF'lerden metin çıkarmak için: ücretsiz, açık kaynak (MIT lisanslı) -->
    <PackageReference Include="MailKit" Version="4.13.0" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="8.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.11" />
    <PackageReference Include="PdfPig" Version="0.1.9" />
    <!-- DWG/DXF çizim dosyalarını okumak için: ücretsiz, açık kaynak (MIT lisanslı). 1.4.0-alpha'da
         bazı Insert (blok referansı) içeren gerçek dünya DWG dosyaları CadInsertTemplate.Build
         içinde NullReferenceException ile parse aşamasında çöküyordu (ACadSharp'ın kendi iç hatası,
         bizim kodumuzdan önce oluşuyordu) — kütüphane o zamandan beri 3.x kararlı sürüme ulaştı. -->
    <PackageReference Include="ACadSharp" Version="3.7.1" />
    <PackageReference Include="PDFtoImage" Version="5.4.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- ÇŞB 2026 rayiç/poz kütüphanesi seed verisi (bkz. Data/PozSeed) — ilk açılışta
         veritabanı boşsa PozKutuphanesi.SeedVeYukleAsync tarafından okunur. -->
    <Content Update="Data\PozSeed\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
