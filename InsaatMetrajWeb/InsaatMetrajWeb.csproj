<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>InsaatMetrajWeb</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- PDF'lerden metin çıkarmak için: ücretsiz, açık kaynak (MIT lisanslı) -->
