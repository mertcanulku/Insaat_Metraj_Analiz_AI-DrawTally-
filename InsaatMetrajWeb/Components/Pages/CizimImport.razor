@page "/proje/{ProjeId:int}/cizim-import"
@inject VeriDeposu Veri
@inject AiSiniflandirmaServisi AiServisi

@if (proje == null)
{
    <p class="hata-mesaj">Proje bulunamadı (id: @ProjeId). <a href="/">Proje listesine dön</a></p>
}
else
{
    <p><a href="@($"/proje/{ProjeId}")">← @proje.Ad</a></p>
    <h1>Çizim Import (DWG / DXF)</h1>
    <p>
        Mimari/statik projenin çizim dosyasını yükle. Sistem sabit bir katman-isim listesine bakmıyor —
        her katmanın <strong>geometrisini</strong> (kapalı mı, çizgi kalınlığı, segment uzunlukları, en/boy oranı)
        katman adıyla birlikte yapay zekaya gönderip hangi poza karşılık geldiğini gerekçesiyle öneriyor.
    </p>
    <p class="hata-mesaj">
        Öneriler asla otomatik eklenmiyor — her biri elle onaylanmalı. Sınıflandırma önce Haiku 4.5'e sorulur,
        modelin kendi güven skoru düşükse aynı katman Sonnet 5'e tekrar sorulur.
    </p>

    <div class="form-satir">
        <label>Çizim Dosyası:</label>
        <InputFile OnChange="DosyaYuklendi" accept=".dwg,.dxf" />
    </div>

    @if (isleniyor)
    {
        <p><em>@isleniyorMesaji</em></p>
    }

    @if (!string.IsNullOrEmpty(genelHataMesaji))
    {
        <p class="hata-mesaj">@genelHataMesaji</p>
    }

    @if (sonuclar.Count > 0)
    {
        <h3>Yapay Zeka Önerileri</h3>
        <table class="veri-tablo">
            <thead>
                <tr>
                    <th>Katman</th>
                    <th>Önerilen Poz</th>
                    <th>Gerekçe</th>
                    <th>Güven / Model</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < sonuclar.Count; i++)
                {
                    var index = i;
                    var s = sonuclar[index];
                    var poz = s.Oneri.PozId.HasValue ? Veri.Pozlar.FirstOrDefault(p => p.Id == s.Oneri.PozId) : null;
                    <tr class="@(s.Eklendi ? "satir-basarili" : (poz == null ? "satir-hatali" : ""))">
                        <td>@s.Sinyal.LayerAdi</td>
                        <td>@(poz != null ? $"{poz.PozKodu} — {poz.Ad}" : "—")</td>
                        <td style="font-size:0.85rem">@s.Oneri.Gerekce</td>
                        <td>%@s.Oneri.Guven — @s.Oneri.KullanilanModel</td>
                        <td>
                            @if (s.Eklendi)
                            {
                                <span>✓ Eklendi</span>
                            }
                            else if (poz != null)
                            {
                                <button @onclick="() => OneriOnayla(index)">Onayla ve Ekle</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    [Parameter]
    public int ProjeId { get; set; }

    private Proje? proje;
    private bool isleniyor;
    private string isleniyorMesaji = "";
    private string genelHataMesaji = "";
    private List<CizimAnalizSonucu> sonuclar = new();

    protected override void OnParametersSet()
    {
        proje = Veri.ProjeBul(ProjeId);
    }

    private async Task DosyaYuklendi(InputFileChangeEventArgs e)
    {
        if (proje == null) return;

        isleniyor = true;
        genelHataMesaji = "";
        sonuclar = new();
        isleniyorMesaji = "Çizim okunuyor, geometrik sinyaller çıkarılıyor...";
        StateHasChanged();

        try
        {
            using var stream = e.File.OpenReadStream(maxAllowedSize: 50 * 1024 * 1024); // 50MB sınır
            using var bellekAkisi = new MemoryStream();
            await stream.CopyToAsync(bellekAkisi);
            bellekAkisi.Position = 0;

            var sinyaller = Veri.CizimSinyalleriniCikar(bellekAkisi, e.File.Name);

            for (int i = 0; i < sinyaller.Count; i++)
            {
                isleniyorMesaji = $"Yapay zeka katmanları değerlendiriyor... ({i + 1}/{sinyaller.Count})";
                StateHasChanged();

                var oneri = await AiServisi.SiniflandirAsync(sinyaller[i], Veri.Pozlar);
                sonuclar.Add(new CizimAnalizSonucu { Sinyal = sinyaller[i], Oneri = oneri });
            }
        }
        catch (Exception ex)
        {
            genelHataMesaji = $"Çizim işlenirken hata oluştu: {ex.Message}";
        }

        isleniyor = false;
    }

    private void OneriOnayla(int index)
    {
        if (proje == null) return;
        var s = sonuclar[index];
        if (!s.Oneri.PozId.HasValue) return;
        var poz = Veri.Pozlar.FirstOrDefault(p => p.Id == s.Oneri.PozId);
        if (poz == null) return;

        Veri.CizimOnerisiniOnayla(proje, s.Sinyal, poz);
        s.Eklendi = true;
    }
}
