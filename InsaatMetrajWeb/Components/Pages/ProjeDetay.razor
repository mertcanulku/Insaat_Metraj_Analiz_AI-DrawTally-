@page "/proje/{ProjeId:int}"
@rendermode InteractiveServer
@attribute [Authorize]
@using Microsoft.AspNetCore.Identity
@inject VeriDeposu Veri
@inject AuthenticationStateProvider AuthProvider
@inject UserManager<ApplicationUser> UserManager

@if (proje == null)
{
    <p class="hata-mesaj">Proje bulunamadı (id: @ProjeId). <a href="/">Proje listesine dön</a></p>
}
else
{
    <p><a href="/"><Icon Name="arrow-left" /> Proje listesi</a></p>
    <h1>@proje.Ad</h1>

    <div class="proje-aksiyonlar">
        <a href="@($"proje/{ProjeId}/metraj-giris")"><Icon Name="plus" /> Metraj Girişi</a>
        <a href="@($"proje/{ProjeId}/proje-import")"><Icon Name="plus" /> Import (CSV/PDF/DWG/DXF)</a>
        <a href="@($"proje/{ProjeId}/hakedis")"><Icon Name="banknote" /> Hakediş</a>
        @if (proje.MetrajKalemleri.Count > 0)
        {
            <a href="@($"proje/{ProjeId}/excel?logo={(excelLogoBasligiEkle ? "true" : "false")}")"><Icon Name="download" /> Excel'e Aktar</a>
            <a href="@($"proje/{ProjeId}/pdf")"><Icon Name="file-text" /> PDF'e Aktar</a>
        }
    </div>

    <details class="proje-ayarlari">
        <summary>Proje Ayarları (Hakediş Varsayılanları)</summary>
        <div class="form-satir">
            <label>Proje Alanı (m²):</label>
            <input type="number" step="0.01" @bind="alanM2" />
        </div>
        <p class="ipucu">Hakediş oluşturma kredisi bu alana göre hesaplanır (her 100 m² = 1 kredi, en az 1).</p>
        <div class="form-satir">
            <label>Sözleşme Bedeli:</label>
            <input type="number" step="0.01" @bind="sozlesmeBedeli" />
        </div>
        <div class="form-satir">
            <label>Sözleşme Tarihi:</label>
            <input type="date" @bind="sozlesmeTarihi" />
        </div>
        <p class="ipucu">Sözleşme tarihi, fiyat farkı otomatik hesabında "temel dönem" olarak kullanılır (bkz. Hakediş &gt; Fiyat Farkı).</p>
        <div class="form-satir">
            <label>Varsayılan Avans Oranı (%):</label>
            <input type="number" step="0.01" @bind="avansOrani" />
        </div>
        <div class="form-satir">
            <label>Varsayılan Teminat Oranı (%):</label>
            <input type="number" step="0.01" @bind="teminatOrani" />
        </div>
        <div class="form-satir">
            <label>Varsayılan Stopaj Oranı (%):</label>
            <input type="number" step="0.01" @bind="stopajOrani" />
        </div>
        <div class="form-satir">
            <label>Varsayılan KDV Oranı (%):</label>
            <input type="number" step="0.01" @bind="kdvOrani" />
        </div>
        <div class="form-satir">
            <label>Varsayılan SGK Kesinti Oranı (%):</label>
            <input type="number" step="0.01" @bind="sgkKesintiOrani" />
        </div>
        <button @onclick="AyarlariKaydet"><Icon Name="check" /> Ayarları Kaydet</button>
        @if (!string.IsNullOrEmpty(ayarMesaji))
        {
            <p class="basarili-mesaj">@ayarMesaji</p>
        }
    </details>

    @if (proje.MetrajKalemleri.Count > 0)
    {
        <label class="excel-secenek">
            <input type="checkbox" @bind="excelLogoBasligiEkle" />
            Excel'de DrawTally başlığı olsun
        </label>
    }

    @if (ilerlemeIzinli && sonHakedisYuzdeleri != null)
    {
        <div class="ilerleme-ozet">
            <div class="ilerleme-ozet-baslik">
                <span><Icon Name="banknote" Size="14" /> İlerleme</span>
                <strong>%@GenelIlerlemeYuzdesi().ToString("0.#")</strong>
            </div>
            <div class="ilerleme-cubuk">
                <div class="ilerleme-cubuk-dolu" style="width:@(GenelIlerlemeYuzdesi().ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%"></div>
            </div>
            <span class="ilerleme-ozet-detay">@ParaFormatlayici.Formatla(GenelIlerlemeTutari()) / @ParaFormatlayici.Formatla(proje.ToplamMaliyet()) tamamlandı (son hakedişe göre)</span>
        </div>
    }
    else if (!ilerlemeIzinli && hakedisVarMi)
    {
        <div class="bos-durum uyelik-sinir-uyari">
            <strong>İlerleme görünümü Pro ve Business planlarında</strong>
            <span>Keşif Özeti'nde tamamlanan/kalan miktar ve tutarları görmek için planını yükseltebilirsin.</span>
            <a href="profil">Planları gör</a>
        </div>
    }

    <h3>Keşif Özeti</h3>
    @if (proje.MetrajKalemleri.Count == 0)
    {
        <div class="bos-durum">
            <strong>Bu projede henüz metraj kalemi yok</strong>
            <span>Yukarıdaki seçeneklerden biriyle ekleyebilirsin.</span>
        </div>
    }
    else
    {
        <div class="disiplin-tablar">
            <button type="button" class="disiplin-tab @(secilenDisiplin == null ? "aktif" : "")" @onclick="() => secilenDisiplin = null">
                Tümü (@proje.MetrajKalemleri.Count)
            </button>
            @foreach (var grup in proje.MetrajKalemleri.GroupBy(k => k.Disiplin).OrderBy(g => g.Key == ProjeDisiplini.Bilinmiyor ? int.MaxValue : (int)g.Key))
            {
                <button type="button" class="disiplin-tab @(secilenDisiplin == grup.Key ? "aktif" : "")" @onclick="() => secilenDisiplin = grup.Key">
                    @DisiplinTespitServisi.GosterimAdi(grup.Key) (@grup.Count())
                </button>
            }
        </div>

        <div class="veri-tablo-wrap">
        <table class="veri-tablo">
            <thead>
                <tr>
                    <th>Disiplin</th>
                    <th>Poz Kodu</th>
                    <th>Poz Adı</th>
                    <th>Ölçüm Detayı</th>
                    <th>Miktar</th>
                    <th>Birim Fiyat</th>
                    <th>Tutar</th>
                    @if (ilerlemeIzinli && sonHakedisYuzdeleri != null)
                    {
                        <th>Tamamlanan %</th>
                        <th>Kalan Miktar</th>
                        <th>Kalan Tutar</th>
                    }
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var k in GosterilenKalemler())
                {
                    <tr>
                        <td>@DisiplinTespitServisi.GosterimAdi(k.Disiplin)</td>
                        <td>@k.Poz.PozKodu</td>
                        <td>@k.Poz.Ad</td>
                        <td>@k.OlcumDetayi</td>
                        <td>@k.Miktar.ToString("0.000")</td>
                        <td>@ParaFormatlayici.Formatla(k.Poz.BirimMaliyet())</td>
                        <td>@ParaFormatlayici.Formatla(k.ToplamMaliyet())</td>
                        @if (ilerlemeIzinli && sonHakedisYuzdeleri != null)
                        {
                            <td>%@KalemYuzdesi(k).ToString("0.#")</td>
                            <td>@((k.Miktar * (100 - KalemYuzdesi(k)) / 100m).ToString("0.000"))</td>
                            <td>@ParaFormatlayici.Formatla(k.ToplamMaliyet() * (100 - KalemYuzdesi(k)) / 100m)</td>
                        }
                        <td><button class="btn-danger" @onclick="() => KalemSil(k.Id)"><Icon Name="trash" /> Sil</button></td>
                    </tr>
                }
            </tbody>
            <tfoot>
                @if (secilenDisiplin != null)
                {
                    <tr>
                        <td colspan="6" style="text-align:right"><strong>@DisiplinTespitServisi.GosterimAdi(secilenDisiplin.Value) ARA TOPLAM</strong></td>
                        <td><strong>@ParaFormatlayici.Formatla(GosterilenKalemler().Sum(k => k.ToplamMaliyet()))</strong></td>
                        @if (ilerlemeIzinli && sonHakedisYuzdeleri != null)
                        {
                            <td></td><td></td><td></td>
                        }
                        <td></td>
                    </tr>
                }
                <tr>
                    <td colspan="6" style="text-align:right"><strong><Icon Name="banknote" Size="14" /> GENEL TOPLAM (tüm disiplinler)</strong></td>
                    <td><strong>@ParaFormatlayici.Formatla(proje.ToplamMaliyet())</strong></td>
                    @if (ilerlemeIzinli && sonHakedisYuzdeleri != null)
                    {
                        <td></td><td></td><td></td>
                    }
                    <td></td>
                </tr>
            </tfoot>
        </table>
        </div>
    }
}

@code {
    [Parameter]
    public int ProjeId { get; set; }

    private Proje? proje;
    private ProjeDisiplini? secilenDisiplin;
    private bool excelLogoBasligiEkle = true;

    private decimal sozlesmeBedeli;
    private DateOnly? sozlesmeTarihi;
    private decimal avansOrani;
    private decimal teminatOrani;
    private decimal stopajOrani;
    private decimal kdvOrani;
    private decimal sgkKesintiOrani;
    private decimal alanM2;
    private string ayarMesaji = "";

    private bool ilerlemeIzinli;
    private bool hakedisVarMi;
    private Dictionary<int, decimal>? sonHakedisYuzdeleri;

    protected override async Task OnParametersSetAsync()
    {
        var sahipId = await AuthProvider.GetUserIdAsync();
        proje = await Veri.ProjeBul(sahipId, ProjeId);
        if (proje != null)
        {
            sozlesmeBedeli = proje.SozlesmeBedeli;
            sozlesmeTarihi = proje.SozlesmeTarihi;
            avansOrani = proje.VarsayilanAvansOrani;
            teminatOrani = proje.VarsayilanTeminatOrani;
            stopajOrani = proje.VarsayilanStopajOrani;
            kdvOrani = proje.VarsayilanKdvOrani;
            sgkKesintiOrani = proje.VarsayilanSgkKesintiOrani;
            alanM2 = proje.AlanM2;

            var kullanici = await UserManager.FindByIdAsync(sahipId);
            ilerlemeIzinli = kullanici != null && UyelikServisi.IlerlemeGorunumuIzinli(kullanici.EtkinPlan);

            if (ilerlemeIzinli)
            {
                sonHakedisYuzdeleri = await Veri.SonHakedisKalemYuzdeleri(sahipId, ProjeId);
            }
            else
            {
                hakedisVarMi = await Veri.HakedisVarMi(sahipId, ProjeId);
            }
        }
    }

    private decimal KalemYuzdesi(MetrajKalemi k) =>
        sonHakedisYuzdeleri != null && sonHakedisYuzdeleri.TryGetValue(k.Id, out var yuzde) ? yuzde : 0;

    private decimal GenelIlerlemeTutari() =>
        proje!.MetrajKalemleri.Sum(k => k.ToplamMaliyet() * KalemYuzdesi(k) / 100m);

    private decimal GenelIlerlemeYuzdesi() =>
        proje!.ToplamMaliyet() == 0 ? 0 : GenelIlerlemeTutari() / proje.ToplamMaliyet() * 100m;

    private async Task AyarlariKaydet()
    {
        if (proje == null) return;
        var sahipId = await AuthProvider.GetUserIdAsync();
        await Veri.ProjeAyarlariGuncelle(sahipId, ProjeId, sozlesmeBedeli, sozlesmeTarihi, avansOrani, teminatOrani, stopajOrani, kdvOrani, sgkKesintiOrani, alanM2);
        proje = await Veri.ProjeBul(sahipId, ProjeId);
        ayarMesaji = "Ayarlar kaydedildi.";
    }

    private List<MetrajKalemi> GosterilenKalemler() =>
        secilenDisiplin == null
            ? proje!.MetrajKalemleri
            : proje!.MetrajKalemleri.Where(k => k.Disiplin == secilenDisiplin).ToList();

    private async Task KalemSil(int metrajKalemiId)
    {
        if (proje == null) return;
        await Veri.MetrajKalemiSil(proje, metrajKalemiId);

        var sahipId = await AuthProvider.GetUserIdAsync();
        proje = await Veri.ProjeBul(sahipId, ProjeId);
    }
}
