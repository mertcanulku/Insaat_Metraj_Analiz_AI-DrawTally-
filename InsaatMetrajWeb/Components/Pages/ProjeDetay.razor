@page "/proje/{ProjeId:int}"
@rendermode InteractiveServer
@attribute [Authorize]
@inject VeriDeposu Veri
@inject AuthenticationStateProvider AuthProvider

@if (proje == null)
{
    <p class="hata-mesaj">Proje bulunamadı (id: @ProjeId). <a href="/">Proje listesine dön</a></p>
}
else
{
    <p><a href="/">← Proje listesi</a></p>
    <h1>@proje.Ad</h1>

    <div class="proje-aksiyonlar">
        <a href="@($"proje/{ProjeId}/metraj-giris")">+ Metraj Girişi</a>
        <a href="@($"proje/{ProjeId}/proje-import")">+ Import (CSV/PDF/DWG/DXF)</a>
    </div>

    <h3>Keşif Özeti</h3>
    @if (proje.MetrajKalemleri.Count == 0)
    {
        <p><em>Bu projede henüz metraj kalemi yok. Yukarıdaki seçeneklerden biriyle ekleyebilirsin.</em></p>
    }
    else
    {
        <div class="disiplin-tablar">
            <button type="button" class="disiplin-tab @(secilenDisiplin == null ? "aktif" : "")" @onclick="() => secilenDisiplin = null">
                Tümü (@proje.MetrajKalemleri.Count)
            </button>
            @foreach (var grup in proje.MetrajKalemleri.GroupBy(k => k.Disiplin).OrderBy(g => g.Key == ProjeDisiplini.Bilinmiyor ? int.MaxValue : (int)g.Key))
            {
                <button type="button" class="disiplin-tab @(secilenDisiplin == grup.Key ? "aktif" : "")" @onclick="() => secilenDisiplin = grup.Key">
                    @DisiplinTespitServisi.GosterimAdi(grup.Key) (@grup.Count())
                </button>
            }
        </div>

        <table class="veri-tablo">
            <thead>
                <tr>
                    <th>Disiplin</th>
                    <th>Poz Kodu</th>
                    <th>Poz Adı</th>
                    <th>Ölçüm Detayı</th>
                    <th>Miktar</th>
                    <th>Birim Fiyat</th>
                    <th>Tutar</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var k in GosterilenKalemler())
                {
                    <tr>
                        <td>@DisiplinTespitServisi.GosterimAdi(k.Disiplin)</td>
                        <td>@k.Poz.PozKodu</td>
                        <td>@k.Poz.Ad</td>
                        <td>@k.OlcumDetayi</td>
                        <td>@k.Miktar.ToString("0.000")</td>
                        <td>@k.Poz.BirimMaliyet().ToString("N2")</td>
                        <td>@k.ToplamMaliyet().ToString("N2")</td>
                        <td><button @onclick="() => KalemSil(k.Id)">Sil</button></td>
                    </tr>
                }
            </tbody>
            <tfoot>
                @if (secilenDisiplin != null)
                {
                    <tr>
                        <td colspan="6" style="text-align:right"><strong>@DisiplinTespitServisi.GosterimAdi(secilenDisiplin.Value) ARA TOPLAM</strong></td>
                        <td><strong>@GosterilenKalemler().Sum(k => k.ToplamMaliyet()).ToString("N2") TL</strong></td>
                        <td></td>
                    </tr>
                }
                <tr>
                    <td colspan="6" style="text-align:right"><strong>GENEL TOPLAM (tüm disiplinler)</strong></td>
                    <td><strong>@proje.ToplamMaliyet().ToString("N2") TL</strong></td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    }
}

@code {
    [Parameter]
    public int ProjeId { get; set; }

    private Proje? proje;
    private ProjeDisiplini? secilenDisiplin;

    protected override async Task OnParametersSetAsync()
    {
        var sahipId = await AuthProvider.GetUserIdAsync();
        proje = await Veri.ProjeBul(sahipId, ProjeId);
    }

    private List<MetrajKalemi> GosterilenKalemler() =>
        secilenDisiplin == null
            ? proje!.MetrajKalemleri
            : proje!.MetrajKalemleri.Where(k => k.Disiplin == secilenDisiplin).ToList();

    private async Task KalemSil(int metrajKalemiId)
    {
        if (proje == null) return;
        await Veri.MetrajKalemiSil(proje, metrajKalemiId);

        var sahipId = await AuthProvider.GetUserIdAsync();
        proje = await Veri.ProjeBul(sahipId, ProjeId);
    }
}
