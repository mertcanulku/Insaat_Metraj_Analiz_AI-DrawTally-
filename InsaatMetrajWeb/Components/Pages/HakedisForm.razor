@page "/proje/{ProjeId:int}/hakedis/form/{HakedisId:int?}"
@rendermode InteractiveServer
@attribute [Authorize]
@using Microsoft.AspNetCore.Identity
@inject VeriDeposu Veri
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Nav
@inject UserManager<ApplicationUser> UserManager

@if (proje == null)
{
    <p class="hata-mesaj">Proje bulunamadı (id: @ProjeId). <a href="/">Proje listesine dön</a></p>
}
else if (hakedis == null)
{
    <p class="hata-mesaj">Hakediş bulunamadı. <a href="@($"/proje/{ProjeId}/hakedis")">Hakediş listesine dön</a></p>
}
else
{
    <p><a href="@($"/proje/{ProjeId}/hakedis")"><Icon Name="arrow-left" /> @proje.Ad — Hakedişler</a></p>
    <h1><Icon Name="banknote" /> @hakedis.HakedisNo. Hakediş</h1>

    <div class="form-satir">
        <label>Tarih:</label>
        <input type="date" @bind="hakedis.Tarih" />
    </div>

    <h3>Kalemler — Kümülatif Tamamlanma (%)</h3>
    @if (hakedis.Kalemler.Count == 0)
    {
        <div class="bos-durum">
            <strong>Bu projede henüz metraj kalemi yok</strong>
            <span>Önce Metraj Girişi'nden kalem eklemelisin.</span>
        </div>
    }
    else
    {
        <div class="veri-tablo-wrap">
        <table class="veri-tablo">
            <thead>
                <tr>
                    <th>Poz Kodu</th>
                    <th>Poz Adı</th>
                    <th>Önceki %</th>
                    <th>Bu Hakediş %</th>
                    <th>Bu Dönem Tutar</th>
                    <th>Kümülatif Tutar</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var k in hakedis.Kalemler)
                {
                    <tr>
                        <td>@k.MetrajKalemi.Poz.PozKodu</td>
                        <td>@k.MetrajKalemi.Poz.Ad</td>
                        <td>%@k.OncekiKumulatifYuzde.ToString("0.##")</td>
                        <td><input type="number" step="0.01" min="0" max="100" style="width:6rem" @bind="k.KumulatifYuzde" @bind:event="oninput" /></td>
                        <td>@ParaFormatlayici.Formatla(k.BuDonemTutar())</td>
                        <td>@ParaFormatlayici.Formatla(k.KumulatifTutar())</td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    }

    @if (tamKapsamliIzinli)
    {
        <h3>Kesinti / Avans / KDV Oranları</h3>
        <p class="ipucu">Proje ayarlarındaki varsayılanlarla önerildi — bu hakediş için istersen değiştirebilirsin.</p>
        <div class="form-satir">
            <label>Avans Oranı (%):</label>
            <input type="number" step="0.01" @bind="hakedis.AvansOrani" @bind:event="oninput" />
        </div>
        <div class="form-satir">
            <label>Teminat Oranı (%):</label>
            <input type="number" step="0.01" @bind="hakedis.TeminatOrani" @bind:event="oninput" />
        </div>
        <div class="form-satir">
            <label>Stopaj Oranı (%):</label>
            <input type="number" step="0.01" @bind="hakedis.StopajOrani" @bind:event="oninput" />
        </div>
        <div class="form-satir">
            <label>KDV Oranı (%):</label>
            <input type="number" step="0.01" @bind="hakedis.KdvOrani" @bind:event="oninput" />
        </div>

        <h3>Fiyat Farkı</h3>
        <p class="ipucu">TÜİK endeks hesabı otomatik yapılmaz — oranı gir, tutar önerilsin, istersen elle değiştir.</p>
        <div class="form-satir">
            <label>Fiyat Farkı Oranı (%):</label>
            <input type="number" step="0.01" @bind="hakedis.FiyatFarkiOrani" @bind:event="oninput" />
            <button type="button" @onclick="FiyatFarkiniOrandanHesapla">Tutarı oranla hesapla</button>
        </div>
        <div class="form-satir">
            <label>Fiyat Farkı Tutarı:</label>
            <input type="number" step="0.01" @bind="hakedis.FiyatFarkiTutari" @bind:event="oninput" />
        </div>
    }
    else
    {
        <div class="bos-durum uyelik-sinir-uyari">
            <strong>Kesinti, avans ve fiyat farkı hesapları Pro ve Business planlarında</strong>
            <span>Starter planda hakediş sadece imalat tutarı ve % üzerinden çalışır.</span>
            <a href="/profil">Planları gör</a>
        </div>
    }

    <h3>Özet</h3>
    <div class="veri-tablo-wrap">
    <table class="veri-tablo">
        <tbody>
            <tr><td>Bu Dönem İmalat Tutarı</td><td>@ParaFormatlayici.Formatla(hakedis.BuDonemImalatTutari())</td></tr>
            @if (tamKapsamliIzinli)
            {
                <tr><td>Fiyat Farkı</td><td>@ParaFormatlayici.Formatla(hakedis.FiyatFarkiTutari)</td></tr>
                <tr><td>Brüt Hakediş Tutarı</td><td>@ParaFormatlayici.Formatla(hakedis.BrutHakedisTutari())</td></tr>
                <tr><td>KDV</td><td>@ParaFormatlayici.Formatla(hakedis.KdvTutari())</td></tr>
                <tr><td>Teminat Kesintisi</td><td>@ParaFormatlayici.Formatla(-hakedis.TeminatKesintisi())</td></tr>
                <tr><td>Stopaj Kesintisi</td><td>@ParaFormatlayici.Formatla(-hakedis.StopajKesintisi())</td></tr>
                <tr><td>Avans Mahsubu</td><td>@ParaFormatlayici.Formatla(-hakedis.AvansMahsubu())</td></tr>
            }
            <tr><td><strong><Icon Name="banknote" Size="14" /> NET ÖDENECEK TUTAR</strong></td><td><strong>@ParaFormatlayici.Formatla(hakedis.NetOdenecekTutar())</strong></td></tr>
        </tbody>
    </table>
    </div>

    @if (HakedisId == null)
    {
        <p class="ipucu">
            Bu hakedişi kaydetmek <strong>@gerekenKredi kredi</strong> harcayacak — bu ay kalan krediniz: <strong>@kalanKredi</strong>.
            @if (!krediYetiyor)
            {
                <span class="hata-mesaj"> Yetersiz kredi, bir sonraki ay yenilenecek.</span>
            }
        </p>
    }

    <button @onclick="Kaydet"><Icon Name="check" /> Hakedişi Kaydet</button>

    @if (!string.IsNullOrEmpty(sonMesaj))
    {
        <p class="@(sonBasarili ? "basarili-mesaj" : "hata-mesaj")">@sonMesaj</p>
    }
}

@code {
    [Parameter]
    public int ProjeId { get; set; }

    [Parameter]
    public int? HakedisId { get; set; }

    private Proje? proje;
    private Hakedis? hakedis;
    private string sonMesaj = "";
    private bool sonBasarili;
    private string? sahipId;
    private bool tamKapsamliIzinli;
    private int gerekenKredi;
    private int kalanKredi;
    private bool krediYetiyor = true;

    protected override async Task OnParametersSetAsync()
    {
        sahipId = await AuthProvider.GetUserIdAsync();
        proje = await Veri.ProjeBul(sahipId, ProjeId);
        if (proje != null)
        {
            hakedis = await Veri.HakedisFormuHazirla(sahipId, ProjeId, HakedisId);

            var kullanici = await UserManager.FindByIdAsync(sahipId);
            tamKapsamliIzinli = kullanici != null && UyelikServisi.HakedisTamKapsamliIzinli(kullanici.EtkinPlan);

            // Starter'da kesinti/avans/fiyat farkı alanları hiç gösterilmiyor — proje varsayılanlarından
            // önerilen değerler formda kalıp yanlışlıkla hesaba karışmasın diye sıfırlanır.
            if (!tamKapsamliIzinli && hakedis != null)
            {
                hakedis.AvansOrani = 0;
                hakedis.TeminatOrani = 0;
                hakedis.StopajOrani = 0;
                hakedis.KdvOrani = 0;
                hakedis.FiyatFarkiOrani = 0;
                hakedis.FiyatFarkiTutari = 0;
            }

            if (HakedisId == null)
            {
                (gerekenKredi, kalanKredi, krediYetiyor) = await Veri.HakedisKrediDurumu(sahipId, ProjeId);
            }
        }
    }

    private void FiyatFarkiniOrandanHesapla()
    {
        if (hakedis == null) return;
        hakedis.FiyatFarkiTutari = hakedis.BuDonemImalatTutari() * hakedis.FiyatFarkiOrani / 100m;
    }

    private async Task Kaydet()
    {
        if (hakedis == null || sahipId == null) return;

        var yuzdeler = hakedis.Kalemler.ToDictionary(k => k.MetrajKalemi.Id, k => k.KumulatifYuzde);
        var sonuc = await Veri.HakedisKaydet(
            sahipId, ProjeId, HakedisId, hakedis.Tarih,
            hakedis.AvansOrani, hakedis.TeminatOrani, hakedis.StopajOrani, hakedis.KdvOrani,
            hakedis.FiyatFarkiOrani, hakedis.FiyatFarkiTutari,
            yuzdeler);

        sonMesaj = sonuc.Mesaj;
        sonBasarili = sonuc.Basarili;

        if (sonuc.Basarili && sonuc.HakedisId is { } id)
        {
            Nav.NavigateTo($"/proje/{ProjeId}/hakedis/{id}");
        }
    }
}
