@page "/poz-kutuphanesi"
@rendermode InteractiveServer
@attribute [Authorize]
@inject VeriDeposu Veri

<h1>Poz Kütüphanesi</h1>
<p>Tüm projelerde ortak kullanılan poz ve analiz kayıtları (ÇŞB rayiç esaslı) — @Veri.Pozlar.Count kayıt.</p>

<input type="text" class="poz-secici-input" style="max-width:28rem"
       placeholder="Poz kodu veya adında ara..."
       value="@aramaMetni" @oninput="AramaDegisti" />

<p class="hata-mesaj" style="color:var(--ink-soft)">
    @if (aramaMetni.Trim().Length == 0)
    {
        <text>@Gosterilecek.Count / @Veri.Pozlar.Count kayıt gösteriliyor — daraltmak için arama kutusunu kullanın.</text>
    }
    else
    {
        <text>@Gosterilecek.Count eşleşme (kod veya ada göre, en fazla @GosterimLimiti gösterilir).</text>
    }
</p>

<table class="veri-tablo">
    <thead>
        <tr>
            <th>Poz Kodu</th>
            <th>Ad</th>
            <th>Birim</th>
            <th>Birim Maliyet</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Gosterilecek)
        {
            <tr>
                <td>@p.PozKodu</td>
                <td>@p.Ad</td>
                <td>@p.Birim</td>
                <td>@p.BirimMaliyet().ToString("N2")</td>
            </tr>
        }
    </tbody>
</table>

@code {
    private const int GosterimLimiti = 300;
    private string aramaMetni = "";

    private List<Poz> Gosterilecek
    {
        get
        {
            var t = aramaMetni.Trim();
            var kaynak = t.Length == 0
                ? Veri.Pozlar
                : Veri.Pozlar.Where(p => p.PozKodu.Contains(t, StringComparison.OrdinalIgnoreCase) || p.Ad.Contains(t, StringComparison.OrdinalIgnoreCase));
            return kaynak.Take(GosterimLimiti).ToList();
        }
    }

    private void AramaDegisti(ChangeEventArgs e) => aramaMetni = e.Value?.ToString() ?? "";
}
