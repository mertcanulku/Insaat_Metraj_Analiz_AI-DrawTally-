@page "/proje/{ProjeId:int}/proje-import"
@rendermode InteractiveServer
@attribute [Authorize]
@inject VeriDeposu Veri
@inject AiSiniflandirmaServisi AiServisi
@inject CizimAnalizServisi CizimAnalizServisi
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthProvider
@inject ILogger<ProjeImport> Logger

@if (proje == null)
{
    <p class="hata-mesaj">Proje bulunamadı (id: @ProjeId). <a href="/">Proje listesine dön</a></p>
}
else
{
    <p><a href="@($"/proje/{ProjeId}")"><Icon Name="arrow-left" /> @proje.Ad</a></p>
    <h1>Proje Import</h1>
    <p>Tek bir yükleme alanından dört formatı destekler:</p>
    <ul>
        <li>
            <strong>CSV</strong> — Excel'den ";" ile ayrılmış: <code>PozKoduVeyaKısaltma;OlçümDetayı;Miktar</code><br />
            Örnek: <code>beton pompa;Perde duvar temeli;15.6</code>
        </li>
        <li>
            <strong>PDF</strong> — dijital (metni seçilebilir) bir metraj/keşif PDF'i olarak okunur; ayrıca
            yapay zeka çizimdeki oda adlarını ve alanlarını (m²) çıkarıp poz önerir. Taranmış (resim) PDF'lerde
            keşif satırı okunamaz, oda analizi görsel üzerinden denenir.
        </li>
        <li>
            <strong>DWG / DXF</strong> — kapalı poligonlardan (oda sınırları) alan shoelace formülüyle
            deterministik hesaplanır, en yakın metin oda adı olarak eşleştirilir, yapay zeka her odaya bir
            poz önerir; öneriler elle onaylanana kadar projeye eklenmez.
        </li>
    </ul>
    <p>
        CSV/PDF'te poz kodu tam bilinmiyorsa kısaltma/eski kod da (alias tablosu üzerinden) tanınır —
        eşleşmeyen satırlar aşağıda ayrıca listelenir, hiçbiri sessizce atlanmaz.
    </p>

    <div class="disiplin-secici">
        <label for="csv-disiplin-secici">CSV/PDF keşif satırlarının disiplini (isteğe bağlı):</label>
        <select id="csv-disiplin-secici" @bind="csvDisiplin">
            @foreach (var d in Enum.GetValues<ProjeDisiplini>())
            {
                <option value="@d">@DisiplinTespitServisi.GosterimAdi(d)</option>
            }
        </select>
        <span class="disiplin-secici-not">
            CSV'nin ve keşif PDF'inin (metraj satırları) çiziminden otomatik disiplin tespiti yapılamadığından,
            bu seçim o dosyadan eklenen satırlara uygulanır. DWG/PDF çizim analizinde disiplin otomatik tespit edilir.
        </span>
    </div>

    <div class="dropzone" id="proje-import-dropzone">
        <div class="dropzone-content">
            <div class="dropzone-icon"><Icon Name="upload-cloud" Size="28" /></div>
            <div class="dropzone-title">Dosyayı buraya sürükleyip bırakın</div>
            <span class="dropzone-sub">veya seçmek için tıklayın</span>
            <div class="dropzone-formats">CSV · PDF · DWG · DXF</div>
        </div>
        <InputFile OnChange="DosyaYuklendi" accept=".csv,.txt,.pdf,.dwg,.dxf" class="dropzone-input" />
    </div>

    <div class="upload-notice">
        <span class="upload-notice-icon"><Icon Name="warning" Size="15" /></span>
        <span class="upload-notice-text">
            En iyi sonuç için PDF çizimlerin yüksek çözünürlüklü ve vektörel (taranmış değil) olmasına,
            DWG çizimlerdeki metinlerin patlatılmamış (düzenlenebilir metin nesnesi olarak kalmış) olmasına
            dikkat edin — bu, hata ve tekrar işi ihtimalini önemli ölçüde azaltır.
        </span>
    </div>

    @if (isleniyor)
    {
        <p><em>@isleniyorMesaji</em></p>
    }

    @if (!string.IsNullOrEmpty(genelHataMesaji))
    {
        <p class="hata-mesaj">@genelHataMesaji</p>
    }

    @if (importSonuclari.Count > 0)
    {
        var basariliSayisi = importSonuclari.Count(s => s.Basarili);
        var basarisizSayisi = importSonuclari.Count - basariliSayisi;

        <h3>Import Sonucu (@sonYuklenenFormat): @basariliSayisi başarılı, @basarisizSayisi eşleşmedi</h3>

        <div class="veri-tablo-wrap"><table class="veri-tablo">
            <thead>
                <tr>
                    <th>Satır</th>
                    <th>Ham Veri</th>
                    <th>Durum</th>
                    <th>Mesaj</th>
                    <th>İşlem</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in importSonuclari)
                {
                    <tr class="@(s.Basarili ? "satir-basarili" : "satir-hatali")">
                        <td>@s.SatirNo</td>
                        <td>@s.HamMetin</td>
                        <td>
                            @if (s.Basarili)
                            {
                                <span class="durum-basarili"><Icon Name="check" /> Başarılı</span>
                            }
                            else if (s.PozEksik)
                            {
                                <span class="durum-uyari"><Icon Name="warning" /> Poz seçilmedi</span>
                            }
                            else
                            {
                                <span class="durum-hata"><Icon Name="x" /> Eşleşmedi</span>
                            }
                        </td>
                        <td>@s.Mesaj</td>
                        <td>
                            @if (s.Basarili && s.EklenenMetrajKalemiId.HasValue)
                            {
                                <button class="btn-danger" @onclick="() => ImportSatiriSil(s)"><Icon Name="trash" /> Sil</button>
                            }
                            else if (s.PozEksik)
                            {
                                <PozSecici Pozlar="Veri.Pozlar" @bind-SeciliPozId="s.SeciliPozId" />
                                <button @onclick="() => ImportSatiriniPozIleTamamla(s)" disabled="@(!s.SeciliPozId.HasValue)">Ekle</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table></div>

        @if (basarisizSayisi > 0)
        {
            <p class="hata-mesaj">
                Poz bulunamayan satırlar için yukarıdan elle poz seçip ekleyebilirsin — hiçbiri sessizce atlanmaz.
            </p>
        }
    }

    @if (odaSonuclari.Count > 0)
    {
        <h3>
            Çizim Analizi — Oda/Alan Önerileri (@sonYuklenenFormat)
            <button class="btn-secondary" @onclick="SonuclariTemizle" title="Aşağıdaki tüm önerileri listeden kaldırır — henüz onaylanmamış satırlar için geri alınamaz, onaylanmış satırlar zaten metraj tablosunda kalır.">Sonuçları Temizle</button>
        </h3>
        <p>
            Aşağıdaki satırlar sadece öneridir; hiçbiri onaylanmadan projenin metraj tablosuna eklenmez.
            Aynı projeye art arda birden fazla dosya (farklı disiplinler dahil) yüklersen sonuçlar üzerine
            yazılmaz, birikir ve aşağıda disipline göre gruplanır — hangi satırın hangi dosyadan geldiği
            "Dosya" sütununda görünür.
        </p>

        @foreach (var grup in odaSonuclari.GroupBy(s => s.Disiplin).OrderBy(g => g.Key == ProjeDisiplini.Bilinmiyor ? int.MaxValue : (int)g.Key))
        {
            var kesinSonuclar = grup.Where(s => s.GuvenSkoru != GuvenSkoru.Dusuk).ToList();
            var belirsizSonuclar = grup.Where(s => s.GuvenSkoru == GuvenSkoru.Dusuk).ToList();
            var kesinOnaysizSayisi = kesinSonuclar.Count(s => !s.OnaylandiMi);

            <details class="disiplin-grup" open>
                <summary><strong>@DisiplinTespitServisi.GosterimAdi(grup.Key)</strong> (@grup.Count() satır)</summary>

                <h4>
                    Kesin Eşleşmeler (@kesinSonuclar.Count)
                    @if (kesinOnaysizSayisi > 0)
                    {
                        <button @onclick="() => TumunuOnayla(grup.Key)">Tümünü Onayla ve Ekle (@kesinOnaysizSayisi)</button>
                    }
                </h4>
                @if (kesinSonuclar.Count == 0)
                {
                    <p><em>Yüksek/orta güvenle eşleşen satır yok.</em></p>
                }
                else
                {
                    @OdaSonucTablosu(kesinSonuclar)
                }

                @if (belirsizSonuclar.Count > 0)
                {
                    <h4>Belirsiz Eşleşmeler (@belirsizSonuclar.Count)</h4>
                    <p>
                        Yapay zekanın güveni düşük olduğu için otomatik eklenmez — gerekçesini okuyup elle
                        poz seçerek veya düzelterek onaylayabilirsin.
                    </p>
                    @OdaSonucTablosu(belirsizSonuclar)
                }
            </details>
        }
    }
}

@code {
    private RenderFragment OdaSonucTablosu(List<CizimAnalizSonucu> liste) => @<div class="veri-tablo-wrap"><table class="veri-tablo">
        <thead>
            <tr>
                <th>Oda Adı</th>
                <th>Miktar</th>
                <th>Kat</th>
                <th>Dosya</th>
                <th>Kaynak</th>
                <th>Güven</th>
                <th>Önerilen Poz</th>
                <th>Gerekçe / Model</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in liste)
            {
                var index = odaSonuclari.IndexOf(s);
                var poz = s.OnerilenPozId.HasValue ? Veri.Pozlar.FirstOrDefault(p => p.Id == s.OnerilenPozId) : null;
                <tr class="@(s.OnaylandiMi ? "satir-basarili" : (poz == null ? "satir-hatali" : ""))">
                    <td>
                        @if (s.OnaylandiMi)
                        {
                            @s.OdaAdi
                        }
                        else
                        {
                            <input type="text" @bind="s.OdaAdi" style="width:100%" />
                        }
                    </td>
                    <td>
                        @if (s.Adet.HasValue)
                        {
                            @if (s.OnaylandiMi)
                            {
                                @($"{s.Adet} adet")
                            }
                            else
                            {
                                <input type="number" @bind="s.Adet" style="width:5rem" /> <text>adet</text>
                            }
                        }
                        else if (s.Uzunluk.HasValue)
                        {
                            @if (s.OnaylandiMi)
                            {
                                @($"{s.Uzunluk?.ToString("0.00")} m")
                            }
                            else
                            {
                                <input type="number" step="0.01" @bind="s.Uzunluk" style="width:6rem" /> <text>m</text>
                            }
                        }
                        else if (s.OnaylandiMi)
                        {
                            @($"{s.AlanM2.ToString("0.00")} m²")
                        }
                        else
                        {
                            <input type="number" step="0.01" @bind="s.AlanM2" style="width:6rem" /> <text>m²</text>
                        }
                    </td>
                    <td>@(string.IsNullOrWhiteSpace(s.KatAdi) ? "—" : s.KatAdi)</td>
                    <td style="font-size:0.85rem">@(string.IsNullOrWhiteSpace(s.KaynakDosya) ? "—" : s.KaynakDosya)</td>
                    <td>@KaynakEtiketi(s.KaynakTuru)</td>
                    <td>@s.GuvenSkoru</td>
                    <td>
                        @if (poz != null)
                        {
                            @($"{poz.PozKodu} — {poz.Ad}")
                        }
                        else if (!s.OnaylandiMi)
                        {
                            <PozSecici Pozlar="Veri.Pozlar" @bind-SeciliPozId="s.SeciliPozId" />
                        }
                        else
                        {
                            @: —
                        }
                    </td>
                    <td style="font-size:0.85rem">@s.OneriGerekcesi @(!string.IsNullOrEmpty(s.KullanilanModel) ? $"({s.KullanilanModel})" : "")</td>
                    <td>
                        @if (s.OnaylandiMi)
                        {
                            <span class="durum-basarili"><Icon Name="check" /> Eklendi</span>
                            <button class="btn-danger" @onclick="() => OdaSonucuSil(s)"><Icon Name="trash" /> Sil</button>
                        }
                        else if (poz != null)
                        {
                            <button @onclick="() => OdaOnerisiOnayla(index)">Onayla ve Ekle</button>
                        }
                        else
                        {
                            <button @onclick="() => OdaOnerisiOnayla(index)" disabled="@(!s.SeciliPozId.HasValue)">Seç ve Ekle</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table></div>;
}

@code {
    [Parameter]
    public int ProjeId { get; set; }

    private Proje? proje;
    private bool isleniyor;
    private string isleniyorMesaji = "";
    private string genelHataMesaji = "";
    private string sonYuklenenFormat = "";
    private List<ImportSonucSatiri> importSonuclari = new();
    private List<CizimAnalizSonucu> odaSonuclari = new();
    private ProjeDisiplini csvDisiplin = ProjeDisiplini.Bilinmiyor;

    protected override async Task OnParametersSetAsync()
    {
        var sahipId = await AuthProvider.GetUserIdAsync();
        proje = await Veri.ProjeBul(sahipId, ProjeId);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("dropzoneVisual", "proje-import-dropzone");
        }
    }

    private async Task DosyaYuklendi(InputFileChangeEventArgs e)
    {
        if (proje == null) return;

        isleniyor = true;
        genelHataMesaji = "";
        importSonuclari = new();
        // odaSonuclari kasıtlı olarak SIFIRLANMIYOR — aynı projeye art arda birden fazla çizim/PDF
        // yüklendiğinde önceki dosyanın sonuçları silinmeden birikir; her satır KaynakDosya alanıyla
        // hangi dosyadan geldiğini taşır (bkz. tablo "Dosya" sütunu).
        StateHasChanged();

        var dosyaAdi = e.File.Name.ToLowerInvariant();

        try
        {
            if (dosyaAdi.EndsWith(".dwg") || dosyaAdi.EndsWith(".dxf"))
            {
                await DwgCizimAnaliziYap(e);
            }
            else if (dosyaAdi.EndsWith(".pdf"))
            {
                sonYuklenenFormat = "PDF";
                isleniyorMesaji = "PDF işleniyor...";
                using var stream = e.File.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024); // 10MB sınır
                using var bellekAkisi = new MemoryStream();
                await stream.CopyToAsync(bellekAkisi);
                bellekAkisi.Position = 0;
                importSonuclari = await Veri.ProjeyePdfImportEt(proje, bellekAkisi, csvDisiplin);

                if (importSonuclari.Count == 0)
                {
                    genelHataMesaji = "PDF'den hiç keşif satırı okunamadı — dosya taranmış (resim) bir PDF olabilir, bu durumda metin katmanı olmadığı için otomatik okuma yapılamıyor.";
                }

                bellekAkisi.Position = 0;
                isleniyorMesaji = "Yapay zeka çizimdeki oda/alanları değerlendiriyor...";
                StateHasChanged();
                odaSonuclari.AddRange(await CizimAnalizServisi.PdfAnalizEt(bellekAkisi, e.File.Name));
            }
            else
            {
                sonYuklenenFormat = "CSV";
                isleniyorMesaji = "CSV işleniyor...";
                using var stream = e.File.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024); // 5MB sınır
                using var reader = new StreamReader(stream);
                var icerik = await reader.ReadToEndAsync();
                importSonuclari = await Veri.ProjeyeCsvImportEt(proje, icerik, csvDisiplin);
            }
        }
        catch (Exception ex)
        {
            // ex.Message tek başına teşhis için yetersiz (ör. "Object reference not set to an
            // instance of an object." stack trace olmadan nereden geldiğini söylemez) — tam
            // exception sunucu konsoluna/log'a yazılır, kullanıcıya kısa mesaj gösterilir.
            Logger.LogError(ex, "Dosya işlenirken hata oluştu: {DosyaAdi}", e.File.Name);
            genelHataMesaji = $"Dosya işlenirken hata oluştu: {ex.Message}";
        }

        isleniyor = false;
    }

    private async Task DwgCizimAnaliziYap(InputFileChangeEventArgs e)
    {
        sonYuklenenFormat = "DWG/DXF";
        isleniyorMesaji = "Çizim okunuyor, oda geometrisi (kapalı poligonlar) ve metinler çıkarılıyor...";
        StateHasChanged();

        using var stream = e.File.OpenReadStream(maxAllowedSize: 50 * 1024 * 1024); // 50MB sınır
        using var bellekAkisi = new MemoryStream();
        await stream.CopyToAsync(bellekAkisi);
        bellekAkisi.Position = 0;

        var yeniSonuclar = CizimAnalizServisi.DwgAnalizEt(bellekAkisi, e.File.Name);

        if (yeniSonuclar.Count == 0)
        {
            genelHataMesaji = "Çizimde kapalı poligon (oda/alan sınırı), blok referansı (kolon/priz vb.) veya elektrik hattı bulunamadı.";
            return;
        }

        isleniyorMesaji = $"Yapay zeka poz önerisi hazırlıyor... (0 / {yeniSonuclar.Count})";
        StateHasChanged();
        // Sadece bu yüklemeden gelen yeni satırlar için poz önerisi istenir — önceki yüklemelerden
        // gelen ve zaten onaylanmış/işlenmiş satırlar tekrar AI'ya gönderilmez. İlerleme raporu
        // olmadan bu adım (onlarca satırda 5-15+ dakika sürebiliyor) sabit bir mesajla "takılı
        // kalmış" gibi görünüyordu — her satır bittiğinde mesaj güncellenir.
        var ilerleme = new Progress<(int Tamamlanan, int Toplam)>(p =>
        {
            isleniyorMesaji = $"Yapay zeka poz önerisi hazırlıyor... ({p.Tamamlanan} / {p.Toplam})";
            StateHasChanged();
        });
        var ilgiliSonuclar = await CizimAnalizServisi.DwgPozOnerileriniEkleAsync(yeniSonuclar, e.File.Name, ilerleme);
        odaSonuclari.AddRange(ilgiliSonuclar);
    }

    private async Task OdaOnerisiOnayla(int index)
    {
        if (proje == null) return;
        var s = odaSonuclari[index];
        var pozId = s.OnerilenPozId ?? s.SeciliPozId;
        if (!pozId.HasValue) return;
        var poz = Veri.Pozlar.FirstOrDefault(p => p.Id == pozId);
        if (poz == null) return;

        await Veri.OdaAnalizSonucunuOnayla(proje, s, poz);
    }

    private async Task TumunuOnayla(ProjeDisiplini disiplin)
    {
        if (proje == null) return;
        // Belirsiz (Düşük güven) satırlar toplu onaya dahil edilmez — Bölüm 5: kullanıcı bunları
        // ayrı sekmede elle inceleyip onaylamalı.
        foreach (var s in odaSonuclari.Where(s => s.Disiplin == disiplin && !s.OnaylandiMi && s.OnerilenPozId.HasValue && s.GuvenSkoru != GuvenSkoru.Dusuk))
        {
            var poz = Veri.Pozlar.FirstOrDefault(p => p.Id == s.OnerilenPozId);
            if (poz != null) await Veri.OdaAnalizSonucunuOnayla(proje, s, poz);
        }
    }

    private async Task OdaSonucuSil(CizimAnalizSonucu s)
    {
        if (proje == null || s.EklenenMetrajKalemiId is not { } id) return;
        if (await Veri.MetrajKalemiSil(proje, id))
        {
            odaSonuclari.Remove(s);
        }
    }

    /// <summary>Öneri listesini temizler — sonuçlar artık dosya yüklemeleri arasında birikiyor
    /// olduğundan, kullanıcının listeyi elle sıfırlayabileceği bir yol gerekiyor. Zaten onaylanmış
    /// (metraj tablosuna eklenmiş) satırlar buradan silinmiyor — sadece görünen öneri listesinden
    /// atılıyor; onları silmek için üstündeki "Sil" butonu kullanılır.</summary>
    private void SonuclariTemizle()
    {
        odaSonuclari.RemoveAll(s => !s.OnaylandiMi);
    }

    private async Task ImportSatiriSil(ImportSonucSatiri s)
    {
        if (proje == null || s.EklenenMetrajKalemiId is not { } id) return;
        if (await Veri.MetrajKalemiSil(proje, id))
        {
            importSonuclari.Remove(s);
        }
    }

    private async Task ImportSatiriniPozIleTamamla(ImportSonucSatiri s)
    {
        if (proje == null || !s.SeciliPozId.HasValue) return;
        var poz = Veri.Pozlar.FirstOrDefault(p => p.Id == s.SeciliPozId);
        if (poz == null) return;

        await Veri.ImportSatiriniManuelPozIleTamamla(proje, s, poz, csvDisiplin);
    }

    private static string KaynakEtiketi(KaynakTuru kaynak) => kaynak switch
    {
        KaynakTuru.VektorMetin => "Vektör metin",
        KaynakTuru.VektorGeometri => "Vektör geometri",
        KaynakTuru.AIGorsel => "AI görsel",
        KaynakTuru.BlokSayimi => "Blok sayımı",
        _ => kaynak.ToString()
    };
}
