@page "/account/cikis"
@layout Layout.LoginLayout
@using Microsoft.AspNetCore.Identity
@using InsaatMetrajWeb.Data
@attribute [Authorize]

@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager

<div class="account-card">
    <h1>Çıkış yapılıyor…</h1>
    <p>Bir sorun olursa <a href="account/giris">buraya tıklayın</a>.</p>
</div>

@code {
    // Şifre değiştirme gibi güvenlik damgasını (security stamp) değiştiren işlemlerden sonra,
    // interaktif bir Blazor Server devresi içinden oturum çerezini güvenle yenilemenin yolu yok
    // (o an HTTP cevabı zaten gönderilmiş oluyor) — bunun yerine kullanıcı buraya (statik, gerçek
    // bir HTTP isteği ile çalışan bu sayfaya) yönlendirilip çıkış yaptırılır ve ReturnUrl ile
    // istenen mesajla birlikte giriş ekranına gönderilir.
    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await SignInManager.SignOutAsync();
        RedirectManager.RedirectTo(ReturnUrl ?? "account/giris");
    }
}
