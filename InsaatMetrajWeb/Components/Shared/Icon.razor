@* Küçük, tutarlı çizgi ikon seti — emoji/unicode sembol yerine kullanılır. currentColor ile tema rengini devralır. *@
<svg class="@($"icon {CssClass}".Trim())" width="@Size" height="@Size" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    @((MarkupString)Path())
</svg>

@code {
    [Parameter, EditorRequired]
    public string Name { get; set; } = "";

    [Parameter]
    public int Size { get; set; } = 16;

    [Parameter]
    public string CssClass { get; set; } = "";

    private string Path() => Name switch
    {
        "check" => "<polyline points=\"20 6 9 17 4 12\" />",
        "x" => "<line x1=\"18\" y1=\"6\" x2=\"6\" y2=\"18\" /><line x1=\"6\" y1=\"6\" x2=\"18\" y2=\"18\" />",
        "warning" => "<path d=\"M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z\" /><line x1=\"12\" y1=\"9\" x2=\"12\" y2=\"13\" /><line x1=\"12\" y1=\"17\" x2=\"12.01\" y2=\"17\" />",
        "arrow-left" => "<line x1=\"19\" y1=\"12\" x2=\"5\" y2=\"12\" /><polyline points=\"12 19 5 12 12 5\" />",
        "arrow-right" => "<line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\" /><polyline points=\"12 5 19 12 12 19\" />",
        "upload-cloud" => "<path d=\"M16 16l-4-4-4 4\" /><path d=\"M12 12v9\" /><path d=\"M20.39 18.39A5 5 0 0 0 18 9h-1.26A8 8 0 1 0 3 16.3\" /><path d=\"M16 16l-4-4-4 4\" />",
        "plus" => "<line x1=\"12\" y1=\"5\" x2=\"12\" y2=\"19\" /><line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\" />",
        "sign-out" => "<path d=\"M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4\" /><polyline points=\"16 17 21 12 16 7\" /><line x1=\"21\" y1=\"12\" x2=\"9\" y2=\"12\" />",
        "folder" => "<path d=\"M4 4h6l2 3h8a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1Z\" />",
        "library" => "<path d=\"M4 19V5a1 1 0 0 1 1-1h4v16H5a1 1 0 0 1-1-1Z\" /><path d=\"M9 4h6v16H9z\" /><path d=\"m16.5 4 3.4 15.6-2 .4L14.5 4.4z\" />",
        "trash" => "<polyline points=\"3 6 5 6 21 6\" /><path d=\"M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2\" />",
        _ => ""
    };
}
