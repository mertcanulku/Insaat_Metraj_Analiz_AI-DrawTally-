@inherits LayoutComponentBase
@using System.Security.Claims
@inject VeriDeposu Veri
@inject AuthenticationStateProvider AuthProvider

<div class="app-shell">
    <nav class="sidebar">
        <div class="sidebar-top-row">
            <a href="projeler" class="brand">
                <img src="images/brand/drawtally-icon-only.svg" alt="" class="brand-mark" />
                <div class="brand-text">
                    <span class="brand-name">DrawTally</span>
                    <span class="brand-sub">by Drongos Global</span>
                </div>
            </a>
        </div>
        <div class="nav-links">
            <span class="nav-group-label">Keşif ve Metraj</span>
            <NavLink href="projeler" Match="NavLinkMatch.All"><Icon Name="folder" /> Projeler</NavLink>
            <NavLink href="poz-kutuphanesi"><Icon Name="library" /> Poz Kütüphanesi</NavLink>
        </div>
    </nav>
    <main class="content">
        <div class="content-topbar">
            <ThemeToggle />
            <AuthorizeView>
                <Authorized>
                    <div class="kullanici-menu">
                        <button type="button" class="kullanici-menu-tetikleyici">
                            <Icon Name="user" />
                            <span class="kullanici-menu-email">@context.User.Identity?.Name</span>
                            @if (kalanKredi.HasValue)
                            {
                                <span class="kullanici-menu-kredi" title="Kalan hakediş kredisi"><Icon Name="banknote" Size="12" /> @kalanKredi</span>
                            }
                        </button>
                        <div class="kullanici-menu-acilir">
                            <a href="profil"><Icon Name="star" /> Profil ve Üyelik</a>
                            <a href="profil"><Icon Name="banknote" /> Kredi Satın Al</a>
                            <a href="account/cikis"><Icon Name="sign-out" /> Çıkış Yap</a>
                        </div>
                    </div>
                </Authorized>
            </AuthorizeView>
        </div>
        <div class="sheet">
            @Body
        </div>
    </main>
</div>

@code {
    private int? kalanKredi;

    protected override async Task OnParametersSetAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        var sahipId = state.User.FindFirstValue(ClaimTypes.NameIdentifier);
        kalanKredi = sahipId != null ? await Veri.KullaniciKalanKredisi(sahipId) : null;
    }
}
